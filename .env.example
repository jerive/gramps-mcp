# Base URL of the Gramps Web API instance to expose over MCP.
GRAMPS_BACKEND_URL=https://your-gramps-instance.example.com

# Comma-separated list of tree names to mount, one MCP sub-server each.
GRAMPS_MCP_TREES=MyTree

# Per-tree service-account credentials. <NAME> is the tree name from
# GRAMPS_MCP_TREES, uppercased with non-alphanumeric characters replaced by `_`.
GRAMPS_MCP_TREE_MYTREE_USERNAME=
GRAMPS_MCP_TREE_MYTREE_PASSWORD=

# required (default): writes need the user's confirmation, and a client that
# cannot ask writes nothing. when-supported: a client that cannot ask has the
# changes applied directly, relying on its own tool approval. Less safe.
GRAMPS_MCP_CONFIRMATION=required

# Set to prefab to add preview_changes, a colour-coded card of planned changes
# for clients that render MCP Apps (experimental).
GRAMPS_MCP_UI=

# Comma-separated emails that bypass per-tree membership checks.
GRAMPS_MCP_ADMIN_EMAILS=

# auto (default): Google sign-in when GOOGLE_CLIENT_ID/SECRET are set.
# off: no authentication even if they are set. For local development only;
# refused unless MCP_BASE_URL is localhost. Also bind MCP_HOST=127.0.0.1.
GRAMPS_MCP_AUTH=auto

# Optional: Google OAuth, required to run this server reachable over a network
# rather than purely on localhost for a single trusted user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MCP_BASE_URL=http://localhost:8000
MCP_GOOGLE_REDIRECT_PATH=/auth/callback
MCP_CLIENT_STORAGE_URL=redis://localhost:6379/0
# How long (seconds) to cache a verified Google token, avoiding a tokeninfo/
# userinfo round-trip on every request. 0 or unset disables caching.
GRAMPS_MCP_GOOGLE_TOKEN_CACHE_TTL=300

# Optional: server bind address/port and logging.
MCP_HOST=0.0.0.0
MCP_PORT=8000
GRAMPS_MCP_LOG_LEVEL=INFO
